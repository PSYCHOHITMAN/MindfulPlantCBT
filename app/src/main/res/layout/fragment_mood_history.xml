<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_screen"
    android:orientation="vertical"
    android:padding="@dimen/screen_padding">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/history_title"
        android:textAppearance="@style/TextAppearance.MPCBT.Headline" />

    <TextView
        android:id="@+id/recordCountText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="@dimen/spacing_md"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        tools:text="3 records" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_card_rounded"
        android:padding="@dimen/spacing_md"
        android:layout_marginBottom="@dimen/spacing_md">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/history_mood_trend_label"
            android:textAppearance="@style/TextAppearance.MPCBT.SectionLabel" />

        <com.mindfulplant.cbt.ui.widget.MoodTrendChartView
            android:id="@+id/moodChart"
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:layout_marginTop="8dp" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/pendingBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_chip_amber_soft"
        android:padding="@dimen/spacing_sm"
        android:layout_marginBottom="@dimen/spacing_sm"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:id="@+id/pendingCountText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/accent_amber"
            android:textStyle="bold"
            android:textSize="13sp"
            tools:text="2 entries pending sync" />

        <TextView
            android:id="@+id/syncNowButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/bg_sync_action"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/history_sync_now"
            android:textColor="@color/accent_mint_dim"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_sm"
        android:layout_marginBottom="@dimen/spacing_sm"
        android:text="@string/history_all_entries"
        android:textAppearance="@style/TextAppearance.MPCBT.SectionLabel" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recordsRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false" />

    <TextView
        android:id="@+id/emptyStateText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="24dp"
        android:text="No entries yet."
        android:textColor="@color/text_secondary"
        android:visibility="gone" />

</LinearLayout>
