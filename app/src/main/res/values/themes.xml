<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.MindfulPlantCBT" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent_mint</item>
        <item name="colorPrimaryVariant">@color/accent_mint_dim</item>
        <item name="colorOnPrimary">@color/bg_screen</item>
        <item name="colorSecondary">@color/accent_mint</item>
        <item name="colorSecondaryVariant">@color/accent_mint_dim</item>
        <item name="colorOnSecondary">@color/bg_screen</item>
        <item name="colorSurface">@color/bg_card</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorError">@color/error</item>
        <item name="android:statusBarColor">@color/bg_screen</item>
        <item name="android:navigationBarColor">@color/bg_screen</item>
        <item name="android:windowBackground">@color/bg_screen</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Serif display style for screen titles / greetings, matching the wireframes -->
    <style name="TextAppearance.MPCBT.Headline" parent="TextAppearance.MaterialComponents.Headline5">
        <item name="android:fontFamily">serif</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">26sp</item>
    </style>

    <style name="TextAppearance.MPCBT.SectionLabel" parent="TextAppearance.MaterialComponents.Subtitle2">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textSize">12sp</item>
    </style>

    <!-- Dark, rounded, mint-on-focus outlined text field -->
    <style name="Widget.MPCBT.TextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/box_stroke_color</item>
        <item name="boxBackgroundColor">@color/bg_card_soft</item>
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
        <item name="android:textColorHint">@color/text_secondary</item>
        <item name="hintTextColor">@color/accent_mint</item>
        <item name="boxStrokeErrorColor">@color/error</item>
        <item name="errorTextColor">@color/error</item>
    </style>

    <!-- Solid mint pill button (primary CTA) -->
    <style name="Widget.MPCBT.Button.Primary" parent="Widget.MaterialComponents.Button">
        <item name="android:textColor">@color/bg_screen</item>
        <item name="android:textStyle">bold</item>
        <item name="backgroundTint">@color/accent_mint</item>
        <item name="cornerRadius">@dimen/radius_md</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- Outlined mint pill button (secondary action) -->
    <style name="Widget.MPCBT.Button.Outline" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textColor">@color/accent_mint</item>
        <item name="strokeColor">@color/divider</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="cornerRadius">@dimen/radius_md</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- Destructive (log out) pill button -->
    <style name="Widget.MPCBT.Button.Destructive" parent="Widget.MaterialComponents.Button">
        <item name="android:textColor">@color/white</item>
        <item name="backgroundTint">@color/error</item>
        <item name="cornerRadius">@dimen/radius_md</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="android:textAllCaps">false</item>
    </style>
</resources>
