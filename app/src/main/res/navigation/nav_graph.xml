<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginFragment">

    <!-- Auth flow -->
    <fragment
        android:id="@+id/loginFragment"
        android:name="com.mindfulplant.cbt.ui.login.LoginFragment"
        android:label="Login"
        tools:layout="@layout/fragment_login">
        <action
            android:id="@+id/action_login_to_register"
            app:destination="@id/registerFragment" />
        <action
            android:id="@+id/action_login_to_home"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/registerFragment"
        android:name="com.mindfulplant.cbt.ui.register.RegisterFragment"
        android:label="Register"
        tools:layout="@layout/fragment_register">
        <action
            android:id="@+id/action_register_to_home"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_register_to_login"
            app:destination="@id/loginFragment" />
    </fragment>

    <!-- Main (bottom-nav) destinations -->
    <fragment
        android:id="@+id/homeFragment"
        android:name="com.mindfulplant.cbt.ui.home.HomeFragment"
        android:label="Home"
        tools:layout="@layout/fragment_home">
        <action
            android:id="@+id/action_home_to_newThoughtRecord"
            app:destination="@id/newThoughtRecordFragment" />
    </fragment>

    <fragment
        android:id="@+id/newThoughtRecordFragment"
        android:name="com.mindfulplant.cbt.ui.thoughtrecord.NewThoughtRecordFragment"
        android:label="New Thought Record"
        tools:layout="@layout/fragment_new_thought_record">
        <action
            android:id="@+id/action_newThoughtRecord_to_home"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/homeFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/moodHistoryFragment"
        android:name="com.mindfulplant.cbt.ui.history.MoodHistoryFragment"
        android:label="Mood History"
        tools:layout="@layout/fragment_mood_history" />

    <fragment
        android:id="@+id/insightsFragment"
        android:name="com.mindfulplant.cbt.ui.insights.InsightsFragment"
        android:label="Insights"
        tools:layout="@layout/fragment_insights" />

    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.mindfulplant.cbt.ui.settings.SettingsFragment"
        android:label="Settings"
        tools:layout="@layout/fragment_settings">
        <action
            android:id="@+id/action_settings_to_login"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
    </fragment>

</navigation>
